# data.go.kr 통합 API 키 (1명이 발급받아 팀 공유)
# 발급: https://www.data.go.kr → 마이페이지 → 인증키 관리 → 디코딩 키 사용
DATA_GO_KR_KEY=your_key_here

# 기상청 API허브 (apihub.kma.go.kr 별도 발급 - data.go.kr와 다른 사이트)
# 발급: https://apihub.kma.go.kr → 회원가입 후 API 키 발급
KMA_API_KEY=your_key_here

# 에어코리아 (data.go.kr와 동일 키)
AIR_KOREA_KEY=your_key_here

# 서버 설정
PORT=8000
FRONTEND_URL=http://localhost:3000
